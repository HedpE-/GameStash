<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\GameStash_Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\GameStash_Icon.ico" />
    <None Remove="Resources\GameStash_Icon.png" />
    <None Remove="Resources\GameStash_Logo_Transparent.jpg" />
    <None Remove="Resources\GameStash_Logo_Transparent.png" />
    <None Remove="Resources\json_example.png" />
    <None Remove="Views\MainWindow.xaml~RF80e53f78.TMP" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\GameStash_Icon.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\GameStash_Icon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\GameStash_Logo_Transparent.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\GameStash_Logo_Transparent.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\json_example.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CardsView" Version="2.8.1" />
    <PackageReference Include="MaterialDesignColors" Version="5.4.0" />
    <PackageReference Include="MaterialDesignExtensions" Version="3.3.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
    <PackageReference Include="Nito.AsyncEx.Coordination" Version="5.1.2" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common.Lib\Common.Lib.csproj" />
    <ProjectReference Include="..\GameStash.Core\GameStash.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\BrowseGamesView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\IgdbGameDetailsView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

</Project>
