<UserControl x:Class="GameStash.MVVM.GUI.Views.LocalLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=System"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:converters="clr-namespace:Common.Lib.Converters;assembly=Common.Lib"
             xmlns:localRoot="clr-namespace:GameStash.MVVM.GUI"
             xmlns:localConverters="clr-namespace:GameStash.MVVM.GUI.Converters"
             xmlns:localViews="clr-namespace:GameStash.MVVM.GUI.Views"
             xmlns:coreModels="clr-namespace:GameStash.Core.Models;assembly=GameStash.Core">
    <UserControl.Resources>
        <ResourceDictionary>
            <localRoot:MainWindowProxy x:Key="MainWindowProxy"/>

            <converters:NullObjectOrStringEmptyConverter x:Key="NullOrStringEmptyToVisibilityConverter" 
                                                         TrueValue="{x:Static Visibility.Visible}" 
                                                         FalseValue="{x:Static Visibility.Collapsed}" />
            <converters:BooleanConverter x:Key="BooleanToVisibilityConverter"
                                         TrueValue="{x:Static Visibility.Visible}"
                                         FalseValue="{x:Static Visibility.Collapsed}" />
            <converters:BooleanConverter x:Key="BooleanToInvertedVisibilityConverter" 
                                         TrueValue="{x:Static Visibility.Collapsed}" 
                                         FalseValue="{x:Static Visibility.Visible}" />
            <converters:ObjectEqualityConverter x:Key="EqualityToVisibilityConverter"
                                                TrueValue="{x:Static Visibility.Visible}"
                                                FalseValue="{x:Static Visibility.Collapsed}" />
            <localConverters:UrlToBitmapConverter x:Key="UrlToBitmapConverter" />
            <localConverters:RatingConverter x:Key="RatingConverter" />
            <localConverters:ListToStringConverter x:Key="ListToStringConverter"/>
            <localConverters:FormatBytesConverter x:Key="FormatBytesConverter" />

            <!--<DataTemplate DataType="{x:Type coreModels:Game}">
                <Border x:Name="GameItemRoot" Tag="{Binding SortName}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        --><!-- Game Card --><!--
                        <Border x:Name="GameCard" Width="150" Height="200" Margin="5"
                            Cursor="Hand" MouseLeftButtonUp="GameCard_MouseLeftButtonUp"
                            ToolTip="{Binding Name}" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <Image Width="150" Height="200" Stretch="UniformToFill"
                                       ImageFailed="Image_ImageFailed"
                                       SnapsToDevicePixels="True" UseLayoutRounding="True" CacheMode="BitmapCache"
                                       Source="{Binding Cover.Value.Url, Converter={StaticResource UrlToImageConverter}, ConverterParameter=cover_big}" />
                                --><!--<Rectangle RadiusX="4" RadiusY="4">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding Cover.Value.Url, Converter={StaticResource UrlToImageConverter}, ConverterParameter=cover_big, FallbackValue='https://images.igdb.com/igdb/image/upload/t_cover_big/nocover.png'}"
                                                Stretch="UniformToFill"/>
                                    </Rectangle.Fill>
                                </Rectangle>-->

                                <!-- StackPanel with buttons, visible only when mouse is over --><!--
                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Background="#80000000">
                                    <materialDesign:PopupBox StaysOpen="False" HorizontalAlignment="Right"
                                                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                        <materialDesign:PopupBox.PopupContent>
                                            <StackPanel>
                                                <Button Command="{Binding Window.DataContext.RefreshCommand, Source={StaticResource MainWindowProxy}}"
                                                    CommandParameter="{Binding .}">
                                                    <Button.Content>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Restart" VerticalAlignment="Center" />
                                                            <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                                    Text="Refresh" FontWeight="SemiBold" Margin="15 0 0 0" />
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                                <Button Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}">
                                                    <Button.CommandParameter>
                                                        <StackPanel Margin="10 20 10 10" Width="350">
                                                            <TextBlock Text="Edit Game Entry"
                                                                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="EditSortNameTextBox"
                                                                        Text="{Binding SortName, UpdateSourceTrigger=Explicit, Mode=TwoWay}"
                                                                        materialDesign:HintAssist.Hint="Sort Name"
                                                                        materialDesign:HintAssist.IsFloating="True"
                                                                        materialDesign:HintAssist.FloatingScale="1.1"
                                                                        materialDesign:TextFieldAssist.HasClearButton="True"
                                                                        Margin="0 25 0 10" FontSize="14" />
                                                                <Button Grid.Column="1" HorizontalAlignment="Center" Content="Save" Margin="5 0 0 0"
                                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                                    Click="EditSortNameSaveButton_Click" />
                                                            </Grid>
                                                            <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                                                                HorizontalAlignment="Center" Content="Close"
                                                                Style="{StaticResource MaterialDesignFlatButton}" />
                                                        </StackPanel>
                                                    </Button.CommandParameter>
                                                    <Button.Content>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Pencil" VerticalAlignment="Center" />
                                                            <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                                    Text="Edit" FontWeight="SemiBold" Margin="15 0 0 0" />
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                                <Button Foreground="Red" Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}">
                                                    <Button.CommandParameter>
                                                        <StackPanel Margin="10 0 10 10" Width="250">
                                                            <TextBlock Text="Remove Game Entry" Margin="0 10"
                                                                    Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                            <TextBlock TextWrapping="WrapWithOverflow">
                                                            <Run Text="This action will remove '" />
                                                            <Run Text="{Binding Name}" />
                                                            <Run Text="' entry permanently." />
                                                            </TextBlock>
                                                            <TextBlock Text="If the folder still exists, it will return to the 'Import from Root Folders' section."
                                                                    TextWrapping="WrapWithOverflow" />
                                                            <TextBlock Text="Are you sure?" Margin="0 10"
                                                                    TextWrapping="WrapWithOverflow" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Click="RemoveGameEntryButton_Click"
                                                                    HorizontalAlignment="Center" Content="Yes"
                                                                    Style="{StaticResource MaterialDesignFlatButton}" />
                                                                <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                                                                    HorizontalAlignment="Center" Content="No" Margin="10 0 0 0"
                                                                    Style="{StaticResource MaterialDesignFlatButton}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button.CommandParameter>
                                                    <Button.Content>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" />
                                                            <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                                    Text="Delete" FontWeight="SemiBold" Margin="15 0 0 0" />
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                            </StackPanel>
                                        </materialDesign:PopupBox.PopupContent>
                                    </materialDesign:PopupBox>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=GameCard}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=GameCard}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                </StackPanel>
                                <ToggleButton Content="{materialDesign:PackIcon Kind=HeartOffOutline}"
                                            IsChecked="{Binding IsFavorite}"
                                            Foreground="White" Background="#80000000" ToolTip="Favorite"
                                            HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <materialDesign:ToggleButtonAssist.OnContent>
                                        <materialDesign:PackIcon Kind="HeartOutline" Foreground="Red" />
                                    </materialDesign:ToggleButtonAssist.OnContent>
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignActionToggleButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False" />
                                                        <Condition Binding="{Binding IsMouseOver, ElementName=GameCard}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Border Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.ToolBar.Background}"
                                    CornerRadius="5" ClipToBounds="True" Background="{DynamicResource MaterialDesign.Brush.Background}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <materialDesign:Card HorizontalAlignment="Center" Padding="4" UniformCornerRadius="14">
                                            <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" />
                                        </materialDesign:Card>
                                        <TextBlock Text="Refreshing..."
                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#80000000" Visibility="{Binding IsFolderValid, Converter={StaticResource BooleanToInvertedVisibilityConverter}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.RemoveLibraryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding .}"
                                            Foreground="Red"
                                            Width="50" Height="50" ToolTip="Game folder not found">
                                            <materialDesign:PackIcon Kind="Delete" Width="40" Height="40" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            --><!--<Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>--><!--
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5 0" MaxWidth="{Binding ElementName=GameCard, Path=ActualWidth}">
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                    Padding="0" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                            <TextBlock Text="{Binding FirstReleaseDate, StringFormat=yyyy}"
                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                    Padding="0" TextAlignment="Center" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow"
                                    Visibility="{Binding DataContext.SelectedSortOption, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Name}" />
                            <TextBlock Text="{Binding FirstReleaseDate, StringFormat=dd/MM/yyyy}"
                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                    Padding="0" TextAlignment="Center" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow"
                                    Visibility="{Binding DataContext.SelectedSortOption, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Release Date}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.SelectedSortOption, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Rating}">
                                <materialDesign:RatingBar IsPreviewValueEnabled="True" Min="0" Max="5"
                                                        ValueIncrements="0.1" IsEnabled="False"
                                                        Value="{Binding TotalRating, Converter={StaticResource RatingConverter}}"
                                                        ToolTip="{Binding TotalRating, Converter={StaticResource RatingConverter}}" />
                                <TextBlock Text="(" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Style="{StaticResource MaterialDesignCaptionTextBlock}" VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding TotalRating, StringFormat=#.#, FallbackValue=0, TargetNullValue=0}" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Style="{StaticResource MaterialDesignCaptionTextBlock}" VerticalAlignment="Bottom" />
                                <TextBlock Text=")" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Style="{StaticResource MaterialDesignCaptionTextBlock}" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Text="{Binding DateAdded, StringFormat=dd/MM/yyyy}"
                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                    Padding="0" TextAlignment="Center" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow"
                                    Visibility="{Binding DataContext.SelectedSortOption, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Date Added}" />
                            <TextBlock Text="{Binding FolderDiskSpaceBytes, Converter={StaticResource FormatBytesConverter}}"
                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                    Padding="0" TextAlignment="Center" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow"
                                    Visibility="{Binding DataContext.SelectedSortOption, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Folder Size}" />
                        </StackPanel>
                    </Grid>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False">
                                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </DataTemplate>-->
            <DataTemplate DataType="{x:Type coreModels:Game}">
                <Border x:Name="GameItemRoot" Tag="{Binding SortName}" Background="Transparent">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Game Card: Otimizado com RenderOptions -->
                        <Border x:Name="GameCard" Width="150" Height="200" Margin="5"
                                Cursor="Hand" MouseLeftButtonUp="GameCard_MouseLeftButtonUp"
                                ToolTip="{Binding Name}" CornerRadius="4" ClipToBounds="True"
                                Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                            <Grid>
                                <!-- Imagem otimizada para renderizar de forma leve durante o scroll -->
                                <Image Width="150" Height="200" Stretch="UniformToFill"
                                       ImageFailed="Image_ImageFailed"
                                       RenderOptions.BitmapScalingMode="LowQuality"
                                       SnapsToDevicePixels="True" UseLayoutRounding="True"
                                       Source="{Binding Cover.Value.Url, Converter={StaticResource UrlToBitmapConverter}, ConverterParameter=cover_big-150}" />
                                <!-- Menu Hover & Favoritos (Oculto por padrão, controlado por Triggers abaixo) -->
                                <Grid x:Name="HoverGrid" Visibility="Collapsed">
                                    <Border Background="#99000000" CornerRadius="4" />
                                    <!-- Botão de Favorito (Topo Esquerdo) -->
                                    <ToggleButton Content="{materialDesign:PackIcon Kind=HeartOffOutline}"
                                                  IsChecked="{Binding IsFavorite}"
                                                  Foreground="White" Background="#80000000" ToolTip="Favorite"
                                                  HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <materialDesign:ToggleButtonAssist.OnContent>
                                            <materialDesign:PackIcon Kind="HeartOutline" Foreground="Red" />
                                        </materialDesign:ToggleButtonAssist.OnContent>
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignActionToggleButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False" />
                                                            <Condition Binding="{Binding IsMouseOver, ElementName=GameCard}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <!-- Menu de Opções (Canto Inferior Direito) -->
                                    <materialDesign:PopupBox StaysOpen="False" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                        <materialDesign:PopupBox.PopupContent>
                                            <StackPanel>
                                                <Button Command="{Binding Window.DataContext.RefreshCommand, Source={StaticResource MainWindowProxy}}"
                                                        CommandParameter="{Binding .}">
                                                    <Button.Content>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Restart" VerticalAlignment="Center" />
                                                            <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                                       Text="Refresh" FontWeight="SemiBold" Margin="15 0 0 0" />
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                                <Button Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}">
                                                    <Button.CommandParameter>
                                                        <StackPanel Margin="10 20 10 10" Width="350">
                                                            <TextBlock Text="Edit Game Entry"
                                                                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="EditSortNameTextBox"
                                                                         Text="{Binding SortName, UpdateSourceTrigger=Explicit, Mode=TwoWay}"
                                                                         materialDesign:HintAssist.Hint="Sort Name"
                                                                         materialDesign:HintAssist.IsFloating="True"
                                                                         materialDesign:HintAssist.FloatingScale="1.1"
                                                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                                                         Margin="0 25 0 10" FontSize="14" />
                                                                <Button Grid.Column="1" HorizontalAlignment="Center" Content="Save" Margin="5 0 0 0"
                                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                                        Click="EditSortNameSaveButton_Click" />
                                                            </Grid>
                                                            <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                                                                    CommandTarget="{Binding ElementName=RootDialog}"
                                                                    HorizontalAlignment="Center" Content="Close"
                                                                    Style="{StaticResource MaterialDesignFlatButton}" />
                                                        </StackPanel>
                                                    </Button.CommandParameter>
                                                    <Button.Content>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Pencil" VerticalAlignment="Center" />
                                                            <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                                       Text="Edit" FontWeight="SemiBold" Margin="15 0 0 0" />
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                                <Button Foreground="Red" Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}">
                                                    <Button.CommandParameter>
                                                        <StackPanel Margin="10 0 10 10" Width="250">
                                                            <TextBlock Text="Remove Game Entry" Margin="0 10"
                                                                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                            <TextBlock TextWrapping="WrapWithOverflow">
                                                            <Run Text="This action will remove '" />
                                                            <Run Text="{Binding Name}" />
                                                            <Run Text="' entry permanently." />
                                                            </TextBlock>
                                                            <TextBlock Text="If the folder still exists, it will return to the 'Import from Root Folders' section."
                                                                       TextWrapping="WrapWithOverflow" />
                                                            <TextBlock Text="Are you sure?" Margin="0 10"
                                                                       TextWrapping="WrapWithOverflow" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Click="RemoveGameEntryButton_Click"
                                                                        HorizontalAlignment="Center" Content="Yes"
                                                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                                                <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                                                                        CommandTarget="{Binding ElementName=RootDialog}"
                                                                        HorizontalAlignment="Center" Content="No" Margin="10 0 0 0"
                                                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button.CommandParameter>
                                                    <Button.Content>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" />
                                                            <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                                       Text="Delete" FontWeight="SemiBold" Margin="15 0 0 0" />
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                            </StackPanel>
                                        </materialDesign:PopupBox.PopupContent>
                                    </materialDesign:PopupBox>
                                </Grid>
                                <!-- Indicador de Refreshing -->
                                <Border Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Background="#B3000000" CornerRadius="4">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}" Width="28" Height="28" />
                                        <TextBlock Text="Loading..." Foreground="White" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Títulos Inferiores -->
                        <StackPanel Grid.Row="1" Margin="5 0" MaxWidth="{Binding ElementName=GameCard, Path=ActualWidth}">
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                    Padding="0" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                            <TextBlock Text="{Binding FirstReleaseDate, StringFormat=yyyy}"
                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                    Padding="0" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"
                                    Visibility="{Binding DataContext.SelectedSortOption, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Name}" />
                            <TextBlock Text="{Binding FirstReleaseDate, StringFormat=dd/MM/yyyy}"
                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                    Padding="0" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"
                                    Visibility="{Binding DataContext.SelectedSortOption, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Release Date}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.SelectedSortOption, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Rating}">
                                <materialDesign:RatingBar IsPreviewValueEnabled="True" Min="0" Max="5"
                                                        ValueIncrements="0.1" IsEnabled="False"
                                                        Value="{Binding TotalRating, Converter={StaticResource RatingConverter}}"
                                                        ToolTip="{Binding TotalRating, Converter={StaticResource RatingConverter}}" />
                                <TextBlock Text="(" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Style="{StaticResource MaterialDesignCaptionTextBlock}" VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding TotalRating, StringFormat=#.#, FallbackValue=0, TargetNullValue=0}" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Style="{StaticResource MaterialDesignCaptionTextBlock}" VerticalAlignment="Bottom" />
                                <TextBlock Text=")" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" Style="{StaticResource MaterialDesignCaptionTextBlock}" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Text="{Binding DateAdded, StringFormat=dd/MM/yyyy}"
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                       Padding="0" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"
                                       Visibility="{Binding DataContext.SelectedSortOption, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Date Added}" />
                            <TextBlock Text="{Binding FolderDiskSpaceBytes, Converter={StaticResource FormatBytesConverter}}"
                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                    Padding="0" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"
                                    Visibility="{Binding DataContext.SelectedSortOption, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Folder Size}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Triggers para controlar a visibilidade do menu Hover de forma leve -->
                <DataTemplate.Triggers>
                    <Trigger SourceName="GameItemRoot" Property="IsMouseOver" Value="True">
                        <Setter TargetName="HoverGrid" Property="Visibility" Value="Visible" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                           Text="Local Games Library"
                           FontWeight="Bold" Margin="0 0 20 0" />
                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                           Text="{Binding SortedImportedGames.Count}"
                           FontWeight="Bold" Margin="0 0 0 4"
                           VerticalAlignment="Bottom" />
            </StackPanel>

            <Grid Margin="10 0 10 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{DynamicResource MaterialDesignFlatPaperButton}" Margin="0 0 10 0"
                            Command="{Binding RefreshLibraryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24" />
                            <TextBlock Text="Reload Library" VerticalAlignment="Center" Margin="10 0 0 0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource MaterialDesignFlatPaperButton}" Margin="0 0 10 0"
                            Command="{Binding CopyGamesListToClipboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardTextMultipleOutline" Width="24" Height="24" />
                            <TextBlock Text="Export List to Clipboard" VerticalAlignment="Center" Margin="10 0 0 0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsLoadingLibrary, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding LoadingLibraryText}" Margin="0 0 0 5" VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                               Style="{StaticResource MaterialDesignBody2TextBlock}" />
                    <ProgressBar Value="{Binding LoadingLibraryProgress}"
                                 Minimum="0" Maximum="1" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <materialDesign:PopupBox StaysOpen="False" HorizontalAlignment="Right" Margin="0 0 10 0"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                             ToolTip="Sort By">
                        <materialDesign:PopupBox.ToggleContent>
                            <materialDesign:PackIcon Kind="Sort" Margin="4 0"
                                                     Width="24" Height="24"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        </materialDesign:PopupBox.ToggleContent>
                        <Grid IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button HorizontalContentAlignment="Left"
                                    Command="{Binding SortCommand}" CommandParameter="Name">
                                <Button.Style>
                                    <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSortOption}" Value="Name">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonText" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Name" />
                                        <Grid Grid.Column="1" Visibility="{Binding SelectedSortOption, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Name}">
                                            <materialDesign:PackIcon Kind="SortAscending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Ascending}}" />
                                            <materialDesign:PackIcon Kind="SortDescending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Descending}}" />
                                        </Grid>
                                    </Grid>
                                </Button.Content>
                            </Button>
                            <Button Grid.Row="1" HorizontalContentAlignment="Left"
                                    Command="{Binding SortCommand}" CommandParameter="Release Date">
                                <Button.Style>
                                    <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSortOption}" Value="Release Date">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonText" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Release Date" />
                                        <Grid Grid.Column="1" Visibility="{Binding SelectedSortOption, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Release Date}">
                                            <materialDesign:PackIcon Kind="SortAscending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Ascending}}" />
                                            <materialDesign:PackIcon Kind="SortDescending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Descending}}" />
                                        </Grid>
                                    </Grid>
                                </Button.Content>
                            </Button>
                            <Button Grid.Row="2" HorizontalContentAlignment="Left"
                                    Command="{Binding SortCommand}" CommandParameter="Rating">
                                <Button.Style>
                                    <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSortOption}" Value="Rating">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonText" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Rating" />
                                        <Grid Grid.Column="1" Visibility="{Binding SelectedSortOption, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Rating}">
                                            <materialDesign:PackIcon Kind="SortAscending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Ascending}}" />
                                            <materialDesign:PackIcon Kind="SortDescending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Descending}}" />
                                        </Grid>
                                    </Grid>
                                </Button.Content>
                            </Button>
                            <Button Grid.Row="3" HorizontalContentAlignment="Left"
                                    Command="{Binding SortCommand}" CommandParameter="Date Added">
                                <Button.Style>
                                    <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSortOption}" Value="Date Added">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonText" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Date Added" />
                                        <Grid Grid.Column="1" Visibility="{Binding SelectedSortOption, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Date Added}">
                                            <materialDesign:PackIcon Kind="SortAscending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Ascending}}" />
                                            <materialDesign:PackIcon Kind="SortDescending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Descending}}" />
                                        </Grid>
                                    </Grid>
                                </Button.Content>
                            </Button>
                            <Button Grid.Row="4" HorizontalContentAlignment="Left"
                                    Command="{Binding SortCommand}" CommandParameter="Folder Size">
                                <Button.Style>
                                    <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSortOption}" Value="Folder Size">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonText" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Folder Size" />
                                        <Grid Grid.Column="1" Visibility="{Binding SelectedSortOption, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Folder Size}">
                                            <materialDesign:PackIcon Kind="SortAscending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Ascending}}" />
                                            <materialDesign:PackIcon Kind="SortDescending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Descending}}" />
                                        </Grid>
                                    </Grid>
                                </Button.Content>
                            </Button>
                        </Grid>
                    </materialDesign:PopupBox>
                    <materialDesign:PopupBox StaysOpen="False" HorizontalAlignment="Right" ToolTip="Filter"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                        <materialDesign:PopupBox.ToggleContent>
                            <materialDesign:PackIcon Kind="Filter" Margin="4 0"
                                                     Width="24" Height="24"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        </materialDesign:PopupBox.ToggleContent>
                        <StackPanel>
                            <Button Content="All" HorizontalContentAlignment="Left"
                                    Command="{Binding FilterCommand}" CommandParameter="All">
                                <Button.Style>
                                    <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFilterOption}" Value="All">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Favorites" HorizontalContentAlignment="Left"
                                    Command="{Binding FilterCommand}" CommandParameter="Favorites">
                                <Button.Style>
                                    <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFilterOption}" Value="Favorites">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Not Favorites" HorizontalContentAlignment="Left"
                                    Command="{Binding FilterCommand}" CommandParameter="Not Favorites">
                                <Button.Style>
                                    <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFilterOption}" Value="Not Favorites">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Installed" HorizontalContentAlignment="Left"
                                    Command="{Binding FilterCommand}" CommandParameter="Installed">
                                <Button.Style>
                                    <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFilterOption}" Value="Installed">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Not Installed" HorizontalContentAlignment="Left"
                                    Command="{Binding FilterCommand}" CommandParameter="Not Installed">
                                <Button.Style>
                                    <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFilterOption}" Value="Not Installed">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Missing Folder" HorizontalContentAlignment="Left"
                                    Command="{Binding FilterCommand}" CommandParameter="Missing">
                                <Button.Style>
                                    <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFilterOption}" Value="Missing">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </materialDesign:PopupBox>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0 10 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- Games list -->
                <ColumnDefinition Width="Auto" />
                <!-- Letters list -->
            </Grid.ColumnDefinitions>
            <!--<ItemsControl x:Name="GamesItemsControl"
              ItemsSource="{Binding SortedImportedGames}"
              ScrollViewer.CanContentScroll="True"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
              VirtualizingPanel.ScrollUnit="Item">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel Margin="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
            </ItemsControl>-->
            <!-- Substituído de ItemsControl para vwp:VirtualizingItemsControl -->
            <vwp:VirtualizingItemsControl x:Name="GamesItemsControl"
                                          ItemsSource="{Binding SortedImportedGames}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel" 
                                          VirtualizingPanel.CacheLengthUnit="Item"
                                          VirtualizingPanel.CacheLength="10,10"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- SpacingMode e StretchItems garantem que o painel calcula o tamanho fixo dos cartões rapidamente -->
                        <vwp:VirtualizingWrapPanel SpacingMode="None" StretchItems="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </vwp:VirtualizingItemsControl>

            <StackPanel Grid.Column="1" Margin="10 0 5 0"
                        VerticalAlignment="Top" Loaded="StackPanel_Loaded"
                        Visibility="{Binding SelectedSortOption, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Name}">
                <ItemsControl ItemsSource="{Binding AvailableLetters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Style="{StaticResource MaterialDesignFlatPaperButton}" Padding="0" Height="25"
                                    Command="{Binding DataContext.ScrollToLetterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
