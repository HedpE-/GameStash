<UserControl x:Class="GameStash.MVVM.GUI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameStash.MVVM.GUI.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:WPFCarouselControl="clr-namespace:GameStash.MVVM.GUI.WPFCarouselControl"
             xmlns:coreModels="clr-namespace:GameStash.Core.Models;assembly=GameStash.Core"
             xmlns:localViews="clr-namespace:GameStash.MVVM.GUI.Views"
             xmlns:viewModels="clr-namespace:GameStash.MVVM.GUI.ViewModels"
             xmlns:localConverters="clr-namespace:GameStash.MVVM.GUI.Converters"
             xmlns:attProps="clr-namespace:Common.Lib.AttachedProperties;assembly=Common.Lib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModels:HomeViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type coreModels:StashGame}">
                <localViews:LibraryGameDetailsView />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Resources/Playarr_Logo_Transparent.jpg"
                       Width="200" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="5"  Stretch="UniformToFill" />
                <TextBlock Style="{StaticResource MaterialDesignHeadline2TextBlock}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                           VerticalAlignment="Center"
                           Text="Playarr" FontWeight="Bold" Margin="20 0 0 0" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0 30 0 0">
                <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                           VerticalAlignment="Center"
                           Text="Most Anticipated Games" FontWeight="Bold" Margin="20 0 0 0" />
                <ItemsControl ItemsSource="{Binding MostAnticipated}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" Margin="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <localViews:GameCardView TitleDateFormat="dd/MM/yyyy" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Auto"
                                          attProps:MouseWheelTiltScrollHelper.EnableHorizontalTiltScroll="True"
                                          Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0 30 0 0">
                <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                           VerticalAlignment="Center"
                           Text="Latest Released Games" FontWeight="Bold" Margin="20 0 0 0" />
                <ItemsControl ItemsSource="{Binding LatestReleases}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" Margin="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <localViews:GameCardView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Auto"
                                          attProps:MouseWheelTiltScrollHelper.EnableHorizontalTiltScroll="True"
                                          Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0 30 0 0">
                <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                           VerticalAlignment="Center"
                           Text="Highest Rated Games on IGDB" FontWeight="Bold" Margin="20 0 0 0" />
                <ItemsControl ItemsSource="{Binding Top10RatedGames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" Margin="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <localViews:GameCardView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Auto"
                                          attProps:MouseWheelTiltScrollHelper.EnableHorizontalTiltScroll="True"
                                          Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
