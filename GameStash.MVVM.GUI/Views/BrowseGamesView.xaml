<UserControl x:Class="GameStash.MVVM.GUI.Views.BrowseGamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=System"
             xmlns:local="clr-namespace:GameStash.MVVM.GUI.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:localViews="clr-namespace:GameStash.MVVM.GUI.Views"
             xmlns:viewModels="clr-namespace:GameStash.MVVM.GUI.ViewModels"
             xmlns:converters="clr-namespace:Common.Lib.Converters;assembly=Common.Lib"
             xmlns:localConverters="clr-namespace:GameStash.MVVM.GUI.Converters"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    <UserControl.DataContext>
        <viewModels:BrowseGamesViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:NullObjectOrStringEmptyConverter x:Key="NullOrStringEmptyToInvertedVisibilityConverter" 
                                                         TrueValue="{x:Static Visibility.Collapsed}" 
                                                         FalseValue="{x:Static Visibility.Visible}" />
            <converters:BooleanConverter x:Key="BooleanToVisibilityConverter"
                                         TrueValue="{x:Static Visibility.Visible}"
                                         FalseValue="{x:Static Visibility.Collapsed}" />
            <converters:ObjectEqualityConverter x:Key="EqualityToVisibilityConverter"
                                                TrueValue="{x:Static Visibility.Visible}"
                                                FalseValue="{x:Static Visibility.Collapsed}" />
            <localConverters:UrlToImageConverter x:Key="UrlToImageConverter" />
            <localConverters:ListToStringConverter x:Key="ListToStringConverter"/>
            <localConverters:RatingConverter x:Key="RatingConverter" />

            <Style TargetType="{x:Type materialDesign:RatingBar}">
                <!-- Mantém as definições originais -->
                <Setter Property="ClipToBounds" Value="False" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type materialDesign:RatingBar}">
                            <ItemsControl Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RatingButtons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=materialDesign:RatingBar}, Path=Orientation}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <!-- Preserva a aparência do RatingBar quando desabilitado -->
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <!-- Evita alteração visual quando o controlo está desabilitado -->
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />

                        <!-- Garantir que a ToolTip ainda seja visível quando o controle está desabilitado -->
                        <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                        <Setter Property="ToolTipService.IsEnabled" Value="True"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Header -->
        <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Text="Browse Games" FontWeight="Bold" Margin="0 0 20 10" />

        <Grid Grid.Row="1" Margin="10 10 20 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox materialDesign:HintAssist.Hint="Enter game name to search..."
                     HorizontalAlignment="Stretch" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="TextBox_KeyDown" />
            <Button Grid.Column="2" Command="{Binding ExecuteSearchCommand}" ToolTip="Search">
                <materialDesign:PackIcon Kind="Search" />
            </Button>
            <Button Grid.Column="4" Command="{Binding ClearSearchResultsCommand}" ToolTip="Clear Search Results">
                <materialDesign:PackIcon Kind="ClearThick" />
            </Button>
        </Grid>

        <Grid Grid.Row="2" Margin="10 20 0 10"
              Visibility="{Binding EnableSearchView, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                <Run Text="The search for '" />
                <Run Text="{Binding CurrentSearchQuery}" FontWeight="Bold" />
                <Run Text="' returned" />
                <Run Text="{Binding SearchResults.Count, Mode=OneWay}" FontWeight="Bold" />
                <Run Text="results." />
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <materialDesign:PopupBox StaysOpen="False" HorizontalAlignment="Right" Margin="0 0 10 0"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                             ToolTip="Sort By">
                    <materialDesign:PopupBox.ToggleContent>
                        <materialDesign:PackIcon Kind="Sort" Margin="4 0"
                                                     Width="24" Height="24"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    </materialDesign:PopupBox.ToggleContent>
                    <Grid IsSharedSizeScope="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button HorizontalContentAlignment="Left"
                                    Command="{Binding SortCommand}" CommandParameter="Name">
                            <Button.Style>
                                <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSortOption}" Value="Name">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonText" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Name" />
                                    <Grid Grid.Column="1" Visibility="{Binding SelectedSortOption, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Name}">
                                        <materialDesign:PackIcon Kind="SortAscending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                 Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Ascending}}" />
                                        <materialDesign:PackIcon Kind="SortDescending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                 Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Descending}}" />
                                    </Grid>
                                </Grid>
                            </Button.Content>
                        </Button>
                        <Button Grid.Row="1" HorizontalContentAlignment="Left"
                                    Command="{Binding SortCommand}" CommandParameter="Release Date">
                            <Button.Style>
                                <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSortOption}" Value="Release Date">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonText" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Release Date" />
                                    <Grid Grid.Column="1" Visibility="{Binding SelectedSortOption, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Release Date}">
                                        <materialDesign:PackIcon Kind="SortAscending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Ascending}}" />
                                        <materialDesign:PackIcon Kind="SortDescending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Descending}}" />
                                    </Grid>
                                </Grid>
                            </Button.Content>
                        </Button>
                        <Button Grid.Row="2" HorizontalContentAlignment="Left"
                                    Command="{Binding SortCommand}" CommandParameter="Rating">
                            <Button.Style>
                                <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSortOption}" Value="Rating">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonText" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Rating" />
                                    <Grid Grid.Column="1" Visibility="{Binding SelectedSortOption, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Rating}">
                                        <materialDesign:PackIcon Kind="SortAscending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Ascending}}" />
                                        <materialDesign:PackIcon Kind="SortDescending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Descending}}" />
                                    </Grid>
                                </Grid>
                            </Button.Content>
                        </Button>
                        <Button Grid.Row="3" HorizontalContentAlignment="Left"
                                    Command="{Binding SortCommand}" CommandParameter="Date Added">
                            <Button.Style>
                                <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSortOption}" Value="Date Added">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonText" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Date Added" />
                                    <Grid Grid.Column="1" Visibility="{Binding SelectedSortOption, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Date Added}">
                                        <materialDesign:PackIcon Kind="SortAscending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Ascending}}" />
                                        <materialDesign:PackIcon Kind="SortDescending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Descending}}" />
                                    </Grid>
                                </Grid>
                            </Button.Content>
                        </Button>
                        <Button Grid.Row="4" HorizontalContentAlignment="Left"
                                    Command="{Binding SortCommand}" CommandParameter="Folder Size">
                            <Button.Style>
                                <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSortOption}" Value="Folder Size">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonText" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Folder Size" />
                                    <Grid Grid.Column="1" Visibility="{Binding SelectedSortOption, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Folder Size}">
                                        <materialDesign:PackIcon Kind="SortAscending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Ascending}}" />
                                        <materialDesign:PackIcon Kind="SortDescending" Margin="10 0 0 0" VerticalAlignment="Center"
                                                                     Visibility="{Binding SelectedSortDirection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter={x:Static scm:ListSortDirection.Descending}}" />
                                    </Grid>
                                </Grid>
                            </Button.Content>
                        </Button>
                    </Grid>
                </materialDesign:PopupBox>
                <materialDesign:PopupBox StaysOpen="False" HorizontalAlignment="Right" ToolTip="Filter"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                    <materialDesign:PopupBox.ToggleContent>
                        <materialDesign:PackIcon Kind="Filter" Margin="4 0"
                                                     Width="24" Height="24"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    </materialDesign:PopupBox.ToggleContent>
                    <StackPanel>
                        <Button Content="All" HorizontalContentAlignment="Left"
                                    Command="{Binding FilterCommand}" CommandParameter="All">
                            <Button.Style>
                                <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFilterOption}" Value="All">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Favorites" HorizontalContentAlignment="Left"
                                    Command="{Binding FilterCommand}" CommandParameter="Favorites">
                            <Button.Style>
                                <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFilterOption}" Value="Favorites">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Not Favorites" HorizontalContentAlignment="Left"
                                    Command="{Binding FilterCommand}" CommandParameter="Not Favorites">
                            <Button.Style>
                                <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFilterOption}" Value="Not Favorites">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Installed" HorizontalContentAlignment="Left"
                                    Command="{Binding FilterCommand}" CommandParameter="Installed">
                            <Button.Style>
                                <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFilterOption}" Value="Installed">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Not Installed" HorizontalContentAlignment="Left"
                                    Command="{Binding FilterCommand}" CommandParameter="Not Installed">
                            <Button.Style>
                                <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFilterOption}" Value="Not Installed">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Missing Folder" HorizontalContentAlignment="Left"
                                    Command="{Binding FilterCommand}" CommandParameter="Missing">
                            <Button.Style>
                                <Style TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFilterOption}" Value="Missing">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </materialDesign:PopupBox>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="3" IsIndeterminate="True"
                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                     Visibility="{Binding Searching, Converter={StaticResource BooleanToVisibilityConverter}}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Value="0" Width="50" />

        <ListBox Grid.Row="3" x:Name="SearchResultsListBox"
                 ItemsSource="{Binding SearchResults}"
                 Visibility="{Binding EnableSearchView, Converter={StaticResource BooleanToVisibilityConverter}}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Standard"
                 ScrollViewer.CanContentScroll="True"
                 IsSynchronizedWithCurrentItem="False"
                 PreviewMouseDown="SearchResultsListBox_PreviewMouseDown">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0 5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" SharedSizeGroup="ItemRow" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Img" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Content" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Game Card -->
                        <Image x:Name="Cover" Width="110" Height="145"
                               Source="{Binding Cover.Value.Url, FallbackValue='https://images.igdb.com/igdb/image/upload/t_cover_small/nocover.png', Converter={StaticResource UrlToImageConverter}, ConverterParameter=cover_small}"
                               Stretch="UniformToFill" />

                        <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Name}"
                                        Style="{StaticResource MaterialDesignBody1TextBlock}"
                                        TextTrimming="CharacterEllipsis" FontWeight="Bold" />

                            <TextBlock Text="{Binding FirstReleaseDate, StringFormat=dd/MM/yyyy, TargetNullValue='No release date available'}"
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" />

                            <StackPanel Orientation="Horizontal">
                                <Grid Visibility="{Binding DeveloperCompany, Converter={StaticResource NullOrStringEmptyToInvertedVisibilityConverter}}">
                                    <Image Source="{Binding DeveloperCompany.Company.Value.Logo.Value.Url, Converter={StaticResource UrlToImageConverter}, ConverterParameter=logo_med}"
                                           Visibility="{Binding DeveloperCompany.Company.Value.Logo, Converter={StaticResource NullOrStringEmptyToInvertedVisibilityConverter}}"
                                           Height="25" Stretch="UniformToFill" Margin="0 0 10 0" />
                                </Grid>
                                <TextBlock Text="{Binding DeveloperCompany.Company.Value.Name, FallbackValue='No developer company available'}"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" />
                            </StackPanel>

                            <TextBlock Text="{Binding Platforms.Values, FallbackValue='No platforms available', Converter={StaticResource ListToStringConverter}}"
                                       TextWrapping="Wrap" Style="{StaticResource MaterialDesignCaptionTextBlock}" />

                            <materialDesign:RatingBar Grid.Column="2"
                                                      IsPreviewValueEnabled="True"
                                                      Min="0" Max="5"
                                                      ValueIncrements="0.1"
                                                      IsEnabled="False"
                                                      Value="{Binding TotalRating, Converter={StaticResource RatingConverter}}"
                                                      ToolTip="{Binding TotalRating, Converter={StaticResource RatingConverter}}" />
                        </StackPanel>

                        <materialDesign:Chip Grid.Column="4"
                                             Content="{Binding Category}"
                                             Background="{DynamicResource MaterialDesign.Brush.Secondary}"
                                             VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <!--<Button Grid.Row="3" Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                Content="{materialDesign:PackIcon Kind=ChevronDoubleUp, Size=40}"
                Command="{Binding ScrollToTopCommand}" Margin="40 40"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Visibility="{Binding IsScrolled, Converter={StaticResource BooleanToVisibilityConverter}}" />-->
    </Grid>
</UserControl>
