<UserControl x:Class="GameStash.MVVM.GUI.Views.FeatureNotImplementedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <!-- No Background or Fixed Size -->
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
            <!-- Title and Icon -->
            <materialDesign:PackIcon Kind="HelpCircle" Width="50" Height="50" 
                                      HorizontalAlignment="Center" VerticalAlignment="Top" />

            <TextBlock Text="This feature is not yet implemented" FontSize="18" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                       Margin="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" />

            <TextBlock Text="Please check back later for updates." HorizontalAlignment="Center" 
                       VerticalAlignment="Center" Margin="10" Foreground="{DynamicResource MaterialDesignBody}" />
        </StackPanel>
    </Grid>
</UserControl>
