<Window x:Class="GameStash.MVVM.GUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:attProps="clr-namespace:Common.Lib.AttachedProperties;assembly=Common.Lib"
        xmlns:local="clr-namespace:GameStash.MVVM.GUI"
        xmlns:viewModels="clr-namespace:GameStash.MVVM.GUI.ViewModels"
        xmlns:localConverters="clr-namespace:GameStash.MVVM.GUI.Converters"
        xmlns:converters="clr-namespace:Common.Lib.Converters;assembly=Common.Lib"
        xmlns:localViews="clr-namespace:GameStash.MVVM.GUI.Views"
        xmlns:coreModels="clr-namespace:GameStash.Core.Models;assembly=GameStash.Core"
        xmlns:igdbModels="clr-namespace:IgdbSharp.Models;assembly=IgdbSharp"
        Title="GameStash" MinHeight="910" MinWidth="1410" Height="910" Width="1400" WindowStartupLocation="CenterScreen"
        materialDesign:ColorZoneAssist.Mode="PrimaryDark" AllowsTransparency="True" WindowStyle="None"
        Background="Transparent" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Loaded="Window_Loaded">

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- BooleanToVisibilityConverter for controlling visibility -->
        <converters:BooleanConverter x:Key="BooleanToVisibilityConverter" 
                                     TrueValue="{x:Static Visibility.Visible}" 
                                     FalseValue="{x:Static Visibility.Collapsed}" />
        <localConverters:WindowStateToPackIconConverter x:Key="WindowStateToPackIconConverter" Size="18"/>

        <!-- Custom menu template -->
        <HierarchicalDataTemplate x:Key="MenuItemTemplate" DataType="{x:Type TreeViewItem}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center" Margin="10 0"/>
                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" Margin="10 0"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type coreModels:StashGame}">
            <localViews:LibraryGameDetailsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type igdbModels:Game}">
            <localViews:IgdbGameDetailsView />
        </DataTemplate>
    </Window.Resources>

    <materialDesign:Card UniformCornerRadius="10">
        <materialDesign:DialogHost x:Name="RootDialog" DialogTheme="Inherit" Identifier="RootDialog" CloseOnClickAway="False">
            <Grid>
                <!-- Define your layout -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Background="{DynamicResource MaterialDesignPaper}">
                    <StackPanel Orientation="Horizontal" Margin="20 20 0 20">
                        <Image Width="30"
                               Height="30"
                               Source="/Resources/Playarr_Icon.png"
                               Stretch="Uniform" />
                        <TextBlock Text="Playarr" Foreground="{DynamicResource MaterialDesignBody}" 
                                   FontSize="20" FontWeight="Bold" Margin="20 0 0 0" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <!-- Side Menu -->
                    <TreeView x:Name="MenuTree" Grid.Column="0" BorderBrush="Transparent" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" 
                              ItemTemplate="{StaticResource MenuItemTemplate}"
                              SelectedItemChanged="MenuTree_SelectedItemChanged">

                        <!-- Home Item -->
                        <TreeViewItem Header="Home" Tag="Home" Cursor="Hand" />

                        <!-- Home Item -->
                        <TreeViewItem Header="Browse Games" Tag="Browse" Cursor="Hand" />

                        <!-- Game Libraries Item -->
                        <TreeViewItem Header="Game Libraries" IsExpanded="True" Cursor="Hand">
                            <TreeViewItem Header="Total Library" Tag="TotalLibrary" Cursor="Hand" />
                            <TreeViewItem Header="Local Library" Tag="LocalLibrary" Cursor="Hand" />
                            <TreeViewItem Header="Epic Library" Tag="EpicLibrary" Cursor="Hand" />
                            <TreeViewItem Header="Steam Library" Tag="SteamLibrary" Cursor="Hand" />
                            <TreeViewItem Header="Amazon Library" Tag="AmazonLibrary" Cursor="Hand" />
                        </TreeViewItem>

                        <!-- Settings Item -->
                        <TreeViewItem Header="Settings" Cursor="Hand">
                            <TreeViewItem Header="Global Settings" Tag="GlobalSettings" Cursor="Hand" />
                            <TreeViewItem Header="Import from Root Folders" Tag="ImportFromRootFolders" Cursor="Hand" />
                        </TreeViewItem>

                        <!-- System Item -->
                        <TreeViewItem Header="System" Tag="System" Cursor="Hand" />
                    </TreeView>
                </StackPanel>

                <!-- Main Area -->
                <Grid Grid.Column="1">
                    <ContentControl x:Name="MainContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <Trigger Property="Content" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
                <Grid Grid.ColumnSpan="2">
                    <!-- Border area for moving the window -->
                    <Grid x:Name="TopHeaderBorder" attProps:EnableDragHelper.EnableDrag="True"
                          MouseLeftButtonDown="TopHeaderBorder_MouseLeftButtonDown"
                          HorizontalAlignment="Stretch" Margin="5 5 5 0" Height="60"
                          VerticalAlignment="Top" Background="Transparent" />

                    <!-- Border areas for resizing -->
                    <Grid x:Name="TopBorder" Cursor="SizeNS" HorizontalAlignment="Stretch" Height="5" VerticalAlignment="Top" Background="Transparent" attProps:WindowResizeHelper.ResizeDirection="Top" />
                    <Grid x:Name="BottomBorder" Cursor="SizeNS" HorizontalAlignment="Stretch" Height="5" VerticalAlignment="Bottom" Background="Transparent" attProps:WindowResizeHelper.ResizeDirection="Bottom" />
                    <Grid x:Name="LeftBorder" Cursor="SizeWE" VerticalAlignment="Stretch" Width="5" HorizontalAlignment="Left" Background="Transparent" attProps:WindowResizeHelper.ResizeDirection="Left" />
                    <Grid x:Name="RightBorder" Cursor="SizeWE" VerticalAlignment="Stretch" Width="5" HorizontalAlignment="Right" Background="Transparent" attProps:WindowResizeHelper.ResizeDirection="Right" />

                    <!-- Corner Resizing Areas -->
                    <Grid x:Name="TopLeftCorner" Cursor="SizeNWSE" HorizontalAlignment="Left" VerticalAlignment="Top" Width="10" Height="10" Background="Transparent" attProps:WindowResizeHelper.ResizeDirection="TopLeft" />
                    <Grid x:Name="TopRightCorner" Cursor="SizeNESW" HorizontalAlignment="Right" VerticalAlignment="Top" Width="10" Height="10" Background="Transparent" attProps:WindowResizeHelper.ResizeDirection="TopRight" />
                    <Grid x:Name="BottomLeftCorner" Cursor="SizeNESW" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="10" Height="10" Background="Transparent" attProps:WindowResizeHelper.ResizeDirection="BottomLeft" />
                    <Grid x:Name="BottomRightCorner" Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="10" Height="10" Background="Transparent" attProps:WindowResizeHelper.ResizeDirection="BottomRight" />

                    <!-- Window Controls -->
                    <StackPanel x:Name="WindowControlsPanel" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10 10">
                        <ToggleButton Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                      Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                      Content="{materialDesign:PackIcon Kind=ThemeLightDark}"
                                      VerticalAlignment="Center" Width="25" Height="25" Padding="0"
                                      Cursor="Hand" IsChecked="True" Click="MenuDarkModeButton_Click" />
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Content="{materialDesign:PackIcon Kind=WindowMinimize, Size=18}"
                                Background="#10000000" Width="25" Height="25"
                                Margin="10 0 0 0" Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Content="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowStateToPackIconConverter}}"
                                Background="#10000000" Margin="10 0"
                                Width="25" Height="25" Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Content="{materialDesign:PackIcon Kind=Close, Size=18}"
                                Background="#10000000"
                                Width="25" Height="25"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
                <materialDesign:Snackbar x:Name="MainSnackbar" Grid.ColumnSpan="2"
                                         MessageQueue="{Binding MessageQueue}"
                                         HorizontalAlignment="Center" 
                                         VerticalAlignment="Bottom"
                                         Margin="20" MaxWidth="500" 
                                         Background="{DynamicResource MaterialDesign.Brush.Background}"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                         ActionButtonPlacement="SeparateLine"
                                         IsActive="True">
                </materialDesign:Snackbar>
            </Grid>
        </materialDesign:DialogHost>
    </materialDesign:Card>
</Window>
