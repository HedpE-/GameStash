<UserControl x:Class="GameStash.MVVM.GUI.Views.GameCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:coreModels="clr-namespace:GameStash.Core.Models;assembly=GameStash.Core"
             xmlns:igdbModels="clr-namespace:IgdbSharp.Models;assembly=IgdbSharp"
             xmlns:localConverters="clr-namespace:GameStash.MVVM.GUI.Converters"
             d:DataContext="{d:DesignInstance igdbModels:Game}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <localConverters:UrlToImageConverter x:Key="UrlToImageConverter" />
            <localConverters:DateFormatterConverter x:Key="DateFormatterConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Game Card -->
        <Border x:Name="GameCard" Width="150" Height="200" Margin="5" CornerRadius="4"
                Cursor="Hand" MouseLeftButtonUp="GameCard_MouseLeftButtonUp">
            <Rectangle RadiusX="4" RadiusY="4" ClipToBounds="True">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{Binding Cover.Value.Url, FallbackValue='https://images.igdb.com/igdb/image/upload/t_cover_big/nocover.png', Converter={StaticResource UrlToImageConverter}, ConverterParameter=cover_big}"
                                Stretch="UniformToFill" />
                </Rectangle.Fill>
            </Rectangle>
            <!-- Style to show the CardTopPanel when mouse is over -->
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <!-- Trigger for showing the CardTopPanel when mouse is over -->
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="Opacity" Value="0.7" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <StackPanel Grid.Row="1" Margin="5 0" MaxWidth="{Binding ElementName=GameCard, Path=ActualWidth}">
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Padding="0"
                       TextTrimming="CharacterEllipsis" TextAlignment="Center" />
            <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Padding="0"
                       TextTrimming="WordEllipsis"
                       TextWrapping="WrapWithOverflow" TextAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource DateFormatterConverter}">
                        <!-- Data binding -->
                        <Binding Path="FirstReleaseDate" />
                        <!-- Format binding from the UserControl -->
                        <Binding Path="TitleDateFormat" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
