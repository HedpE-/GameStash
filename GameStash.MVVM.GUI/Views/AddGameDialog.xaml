<UserControl x:Class="GameStash.MVVM.GUI.Views.AddGameDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <StackPanel>
            <TextBlock Text="Adicionar Jogo" FontSize="20" FontWeight="Bold" Margin="10"/>
            <TextBox materialDesign:HintAssist.Hint="Nome do jogo" Margin="10"/>
            <Button Content="Adicionar" Margin="10" 
                    Command="{Binding AddGameCommand}" 
                    Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>
    </Grid>
</UserControl>