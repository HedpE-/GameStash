<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Configures the build output to target Windows Service lifecycle -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Forces the compiler to copy all secondary NuGet references from project dependencies into the execution folder -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ApplicationIcon>Resources\GameStash_Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Resources\Noto\**" />
    <Compile Remove="Resources\Roboto\**" />
    <Content Remove="Resources\Noto\**" />
    <Content Remove="Resources\Roboto\**" />
    <EmbeddedResource Remove="Resources\Noto\**" />
    <EmbeddedResource Remove="Resources\Roboto\**" />
    <None Remove="Resources\Noto\**" />
    <None Remove="Resources\Roboto\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\GameStash_Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Nito.Collections.Deque" Version="1.2.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\GameStash_Icon.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\GameStash_Icon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\GameStash_Logo_Transparent.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\GameStash_Logo_Transparent.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\json_example.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameStash.Core\GameStash.Core.csproj" />
  </ItemGroup>

</Project>
