<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ApplicationIcon>Resources\GameStash_Icon.ico</ApplicationIcon>
    <UserSecretsId>bc1cfbe6-8457-40d5-9d41-ac012c85e721</UserSecretsId>
  </PropertyGroup>

  <!-- Estas opções SÓ se aplicam quando fazes Publish em Release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Resources\Noto\**" />
    <Compile Remove="Resources\Roboto\**" />
    <Content Remove="Resources\Noto\**" />
    <Content Remove="Resources\Roboto\**" />
    <EmbeddedResource Remove="Resources\Noto\**" />
    <EmbeddedResource Remove="Resources\Roboto\**" />
    <None Remove="Resources\Noto\**" />
    <None Remove="Resources\Roboto\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />
    <Content Include="Resources\GameStash_Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.GenAI" Version="1.28.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Nito.Collections.Deque" Version="1.2.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\amazon-games-icon.svg" />
    <EmbeddedResource Include="Resources\epic-games.svg" />
    <EmbeddedResource Include="Resources\GameStash_Icon.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\GameStash_Icon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\GameStash_Logo_Transparent.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\GameStash_Logo_Transparent.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\gogdotcom.svg" />
    <EmbeddedResource Include="Resources\json_example.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\steam.svg" />

    <!-- Embute toda a pasta wwwroot (HTML, JS, CSS, favicon) dentro do executável -->
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\amazon-games-icon.svg" />
    <None Remove="Resources\epic-games.svg" />
    <None Remove="Resources\gogdotcom.svg" />
    <None Remove="Resources\steam.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameStash.Core\GameStash.Core.csproj" />
  </ItemGroup>

</Project>
